# Runtime configuration contract; no live credentials. Copy to .env.local for development.
NODE_ENV=development
# Origins stay unprefixed; UI routes add /cs or /en, APIs/callbacks do not.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Disposable local database (see infra/compose.dev.yaml); production uses a dedicated role.
DATABASE_URL=
# Bundled migration location override (image default: /app/migrations).
MIGRATIONS_DIR=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# JSON map from guild role IDs to the explicit application-role allowlist.
DISCORD_ROLE_MAPPING_JSON={}
DISCORD_INVITE_URL=https://discord.gg/vlkhll
HLL_WEBSITE_URL=https://valkyriahll.cz/
HLL_MATCH_ARCHIVE_URL=https://valkyriahll.cz/matches
# Private persistent storage for editorial uploads; delivery is publication-aware.
EDITORIAL_MEDIA_ROOT=.local/editorial-media
# Discord REST base URL; change only for isolated adapter tests.
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Enable only after operator provisioning + MFA enrollment is implemented.
LOCAL_ADMIN_LOGIN_ENABLED=false
# Empty sources must render a deliberate static fallback, never a broken player.
BACKGROUND_VIDEO_MP4_URL=
BACKGROUND_VIDEO_WEBM_URL=
BACKGROUND_POSTER_URL=
# Comma-separated HTTPS origins that admins may use for background media (added to CSP).
BACKGROUND_MEDIA_ALLOWED_ORIGINS=
# Server-only: web needs the bot token for v1 member REST lookups; worker also
# needs it when enabled. ROLE_SYNC_SIGNING_SECRET is shared by sender/verifier.
# Never expose either value in browser bundles.
DISCORD_BOT_TOKEN=
ROLE_SYNC_SIGNING_SECRET=
# Optional private bot management; disabled until an operator provisions both sides.
# HTTPS exact origins by default. Private HTTP requires explicit opt-in and a private
# numeric address, localhost, or an operator-controlled single-label service name.
BOT_MANAGEMENT_ENABLED=false
BOT_MANAGEMENT_ORIGIN=
BOT_MANAGEMENT_ALLOWED_ORIGINS=
BOT_MANAGEMENT_ALLOW_PRIVATE_HTTP=false
BOT_MANAGEMENT_KEY_ID=
# Dedicated management key only; never reuse auth, Discord, or role-sync secrets.
BOT_MANAGEMENT_SECRET=
