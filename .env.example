# Runtime configuration contract; no live credentials. Copy to .env.local for development.
NODE_ENV=development
# Origins stay unprefixed; UI routes add /cs or /en, APIs/callbacks do not.
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Disposable local database (see infra/compose.dev.yaml); production uses a dedicated role.
DATABASE_URL=
# Bundled migration location override (image default: /app/migrations).
MIGRATIONS_DIR=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# JSON map from guild role IDs to the explicit application-role allowlist. A role list is
# a platform-wide grant; {"roles":["editor"],"games":["hell-let-loose"]} limits it to games
# (game-scoped grants never carry media/settings/audit/access capabilities).
DISCORD_ROLE_MAPPING_JSON={}
DISCORD_INVITE_URL=https://discord.gg/vlkhll
HLL_WEBSITE_URL=https://valkyriahll.cz/
HLL_MATCH_ARCHIVE_URL=https://valkyriahll.cz/matches
# Private persistent storage for editorial uploads; delivery is publication-aware.
EDITORIAL_MEDIA_ROOT=.local/editorial-media
# Discord REST base URL; change only for isolated adapter tests.
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Enable only after operator provisioning + MFA enrollment is implemented.
LOCAL_ADMIN_LOGIN_ENABLED=false
# Empty sources must render a deliberate static fallback, never a broken player.
BACKGROUND_VIDEO_MP4_URL=
BACKGROUND_VIDEO_WEBM_URL=
BACKGROUND_POSTER_URL=
# Comma-separated HTTPS origins that admins may use for background media (added to CSP).
BACKGROUND_MEDIA_ALLOWED_ORIGINS=
# Reviewed HLL stage clips (JSON array, see apps/web/src/modules/hll/media.ts). Empty until
# owner-approved clan footage exists; the HLL landing then shows its static fallback.
HLL_BACKGROUND_CLIPS_JSON=[]
# Game-server status source: none (default); crcon reads the public CRCON information of
# the servers below; synthetic-fixture only for development/tests (labelled synthetic data).
SERVER_STATUS_SOURCE=none
SERVER_STATUS_FIXTURE_SCENARIO=mixed
# JSON array for SERVER_STATUS_SOURCE=crcon, e.g.
# [{"publicId":"valkyria-1","name":"Valkyria #1","baseUrl":"https://crcon.example.org","address":"host.example.org:7777","statsUrl":"https://stats.example.org/","serverNumber":1}]
# Pin serverNumber when instances share a history database. Result URL imports accept
# only the configured statsUrl base + /games/<id>, then validate the returned server.
# Configure the real hosts in the deployment environment only, never in this repository.
HLL_SERVER_SOURCES_JSON=[]
# Optional operator audit credentials, never browser values. Public CRCON reads do not
# require these. The app does not turn this account into an API token or session.
LEGACY_CRCON_USERNAME=
LEGACY_CRCON_PASSWORD=
# Legacy HLL hostnames routed to this app at the domain cutover (comma-separated). Empty
# disables legacy redirects; set only per the release runbook together with DNS changes.
LEGACY_HLL_HOSTS=
# Server-only: web needs the bot token for v1 member REST lookups; worker also
# needs it when enabled. ROLE_SYNC_SIGNING_SECRET is shared by sender/verifier.
# Never expose either value in browser bundles.
DISCORD_BOT_TOKEN=
ROLE_SYNC_SIGNING_SECRET=
